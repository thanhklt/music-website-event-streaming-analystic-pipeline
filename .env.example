KAFKA_ADDRESS=localhost
KAFKA_PORT=9093
# Example UUID only. Generate a NEW ID once for your new cluster; preserve it on restart.
KAFKA_CLUSTER_ID=tQ8xj8d5Q7Gj3Rt2uN6Bhw
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9093,127.0.0.1:19093,127.0.0.1:29093
# Business/test topics: 2 partitions, replication factor 2, min.insync.replicas 2.
# Eventsim runs inside Docker and uses INTERNAL bootstrap addresses instead.
EVENTSIM_KAFKA_BOOTSTRAP_SERVERS=kafka-1:9092,kafka-2:9092,kafka-3:9092
EVENTSIM_KAFKA_NETWORK=eventsim-net
HDFS_URL=hdfs://localhost:9000
HDFS_BASE_PATH=/data/events-kafka-v2
HDFS_CHECKPOINT_PATH=/checkpoint/kafka-v2
HDFS_NAMENODE_HTTP=http://localhost:9870
HUE_PORT=8888
OUTPUT_FORMAT=parquet

# Streamlit: set in the launching process (PowerShell $env:...), or use sidebar.
DASHBOARD_DUCKDB_PATH=infra/duckdb/data/warehouse.duckdb
